{
  "name": "feedoback-react",
  "version": "0.2.0",
  "description": "React and Next.js SDK for the Feedoback website feedback widget. One component, no manual setup.",
  "license": "MIT",
  "author": "Masoud <dev3mike@gmail.com>",
  "homepage": "https://feedoback.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedoback/feedoback-sdks.git",
    "directory": "react"
  },
  "bugs": "https://github.com/feedoback/feedoback-sdks/issues",
  "keywords": [
    "feedoback",
    "feedback",
    "widget",
    "react",
    "nextjs",
    "bug-report",
    "screen-recording"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsup --silent && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true
  }
}
