<?xml version="1.0" encoding="utf-8"?>
<!--
  No permissions at all beyond the internet the host app already has. In
  particular not SYSTEM_ALERT_WINDOW: the floating button lives in the
  Activity's own view, never over other apps.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
