{
  "name": "feedoback-react-native",
  "version": "0.1.1",
  "description": "React Native SDK for Feedoback. A native feedback sheet from a control your app already owns, or a floating launcher over it.",
  "license": "MIT",
  "author": "Masoud <dev3mike@gmail.com>",
  "homepage": "https://feedoback.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedoback/feedoback-sdks.git",
    "directory": "react-native"
  },
  "bugs": "https://github.com/feedoback/feedoback-sdks/issues",
  "keywords": [
    "feedoback",
    "feedback",
    "react-native",
    "ios",
    "android",
    "bug-report",
    "turbo-module"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "lib",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "FeedobackReactNative.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native/typescript-config": "^0.81.0",
    "@types/react": "^19",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "codegenConfig": {
    "name": "RNFeedobackSpec",
    "type": "all",
    "jsSrcsDir": "src/spec",
    "android": {
      "javaPackageName": "com.feedoback.reactnative"
    },
    "ios": {
      "componentProvider": {
        "FeedobackRedactView": "FeedobackRedactView"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/*.test.{ts,tsx}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
